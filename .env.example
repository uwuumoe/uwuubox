# Copy to .env and fill in secrets. Only SESSION_SECRET has no default.
UWUU_DATABASE_URL=postgres://uwuubox:uwuubox@127.0.0.1:5432/uwuubox
UWUU_PORT=3000
# REQUIRED: 64 hex chars. Generate with: openssl rand -hex 32
UWUU_SESSION_SECRET=change-me-to-openssl-rand-hex-32-output-0000000000000000
UWUU_BASE_URL=http://127.0.0.1:3000

# Storage: local | s3
UWUU_STORAGE_BACKEND=local
UWUU_LOCAL_DIR=./data
# S3-compatible (MinIO/Garage/R2 via endpoint_url + path style):
# UWUU_S3_ENDPOINT=http://127.0.0.1:9000
# UWUU_S3_BUCKET=uwuubox
# UWUU_S3_REGION=auto
# UWUU_S3_ACCESS_KEY=minioadmin
# UWUU_S3_SECRET_KEY=minioadmin
# UWUU_S3_PATH_STYLE=true

# Single generic OIDC provider (issuer URL, e.g. https://accounts.google.com):
# UWUU_OIDC_ENABLED=false
# UWUU_OIDC_DISCOVERY_URL=
# UWUU_OIDC_CLIENT_ID=
# UWUU_OIDC_CLIENT_SECRET=
# UWUU_OIDC_REDIRECT_URL=http://127.0.0.1:3000/oidc/callback
